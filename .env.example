# Copy this file to .env and fill in your values.
# The .env file is never committed to version control.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the Claude model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: override max tokens returned by Claude (default: 4096)
# CLAUDE_MAX_TOKENS=4096
